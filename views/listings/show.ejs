<% layout('layouts/boilerplate') -%>
<body>
    <script>
        const mapToken = "<%=process.env.MAP_TOKEN%>"
        const listing = JSON.parse('<%- JSON.stringify(item) %>');   
        // const location =  JSON.parse('<%- JSON.stringify(item.location) %>')
    </script>
        <!-- flashes are in flash.ejs and linked to boilerplate -->
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3><%=item.title%></h3>
        </div>
        <div class="card col-6 offset-3 mt-3 show-card listing-card">
            <label for="image-url" class="form-label"></label>
            <!-- <img src="<%-item.image.url%>" class="card-img-top show-img" alt="<%=item.title%> image"> -->
            <img src="<%= item.image && item.image.url ? item.image.url : 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQT1DflnlW9CQWyZhnX-ev_Fm-sb8SQWAHKIMJqj3cAk1IRKyP-Cj0vvWo&s=10' %>" class="card-img-top show-img" alt="<%= item.title %> image">
            <div class="card-body">
                <p class="card-text mt-2">Owned by : <i><%=item.owner.username%></i> </p>
                <p class="card-text "><%=item.description%></p> 
                <p class="card-text ">&#8377;<%=item.price.toLocaleString("en-IN")%></p> 
                <p class="card-text "><%=item.location%></p> 
                <p class="card-text "> <%=item.country%></p> 
            </div>
        </div>
    </div>

    <!-- checking the id of curruser and owner ids and only if they match then show these buttons -->
     <!-- <% if(currUser && currUser._id.equals(item.owner._id)) { %> -->
    <div class="btns">
        <a href="/listings/<%=item.id%>/edit" class="btn btn-dark col-1 offset-3">
            Edit
        </a>

        <form action="/listings/<%=item.id%>?_method=DELETE" method="post" onsubmit="return confirm('Are you sure you want to delete this?');">            
            <button class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
    <% } %>
    
    <!-- stage-2 adding reviews for each listing -->
<!-- only letting user to add a review only if logged in -->
    <div class="col-8 offset-3 mb-3"><hr>
        <p><% if(currUser) { %></p>
        <h4>Leave a Review!</h4>
        <form action="/listings/<%=item.id%>/reviews" method="post" novalidate class="needs-validation">
            <!-- <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
            </div>  -->
            
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rate the place :</label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rates2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comment here!</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5"  class="form-control" required></textarea>
                <div class="invalid-feedback">
                    Please fill out this field!
                </div>                
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr>
        <% } %>
        

        <h5>All Reviews</h5>
        <div class="row ">
            <% if(item.reviews && item.reviews.length > 0) { %>
            <% for (i of item.reviews) { %>
                <div class="card col-5 mb-3 mt-3 ms-3">
                    <div class="card-body">
                        <h5 class="card-title mt-1">@<%= i.author.username %></h5>         <!--here you can use author name populated in listing.js for every single review                     -->
                        <p class="starability-result card-text" data-rating="<%=i.rating%>"></p>
                        <p class="card-text"><%=i.comment%></p>
                        <p class="card-text"><%=i.rating%></p>
                    </div>
                    <br>
                    <form action="/listings/<%=item._id%>/reviews/<%=i._id%>?_method=DELETE" class="mb-3" method="post">
                        <button class="btn btn-small btn-dark">Delete</button>
                    </form>
                </div>
                <% } %>
            <% } else { %>
                <p class="card-text"><p>No reviews yet!</p></p>
            <% } %>
        </div>
        <hr>
    </div>
    <div class="col-8 offset-3 mb-3">
        <h3>You'll be here </h3>
        <div id="map"></div>
    </div>
    <script src="/js/map.js"></script>
</body>
</html>