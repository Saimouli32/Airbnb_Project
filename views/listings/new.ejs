<% layout('layouts/boilerplate') -%>
<body>
        <!-- flashes are in flash.ejs and linked to boilerplate -->

    <div class="row mt-3">
        <div class="col-6 offset-3">
            <h2>Create a new Listing</h2>
            <form action="/listings" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" placeholder="Enter title" class="form-control" required> 
                    <!-- for correct and incorrect text  -->
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please enter a relevant title!
                    </div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea type="text" name="listing[description]" class="form-control" required></textarea> 
                    <div class="invalid-feedback">
                        Please enter a valid description!
                    </div>
                    <div class="valid-feedback">
                        Awesome!
                    </div>
                </div>

                <!-- <div class="mb-3">
                    <label for="image" class="form-label">Link of image </label>
                    <input type="text" name="listing[image][url]" placeholder="Enter image url/link" class="form-control"> 
                </div> -->

                <div class="mb-3">
                    <label for="image" class="form-label">Upload Listing image </label>
                    <input type="file" name="listing[image][url]" class="form-control"> 
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" name="listing[price]" placeholder="Enter price" class="form-control" required> 
                        <div class="invalid-feedback">
                        Please provide a valid price!
                        </div>
                        <div class="valid-feedback">
                            Great!
                        </div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="listing[location]" placeholder="Enter location" class="form-control" required>
                        <div class="invalid-feedback">
                            Please enter a valid location!
                        </div>
                        <div class="valid-feedback">
                            Crazy place!
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" placeholder="Enter country" class="form-control" required>
                    <div class="invalid-feedback">
                        Please enter a valid country!
                    </div>
                    <div class="valid-feedback">
                        Power nation!
                    </div>
                </div>
                <button class="btn btn-dark add-btn mt-3">Add Listing</button> <br><br>
            </form> 
        </div>
    </div>
</body>
</html>