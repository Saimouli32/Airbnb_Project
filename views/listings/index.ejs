<% layout('layouts/boilerplate') -%>
<body>
    <!-- flashes are in flash.ejs and linked to boilerplate -->

    <!-- <h2>All Listings</h2> -->
    <style>
        #filters{
            margin-top: 1rem;
            display:flex;
            flex-wrap:wrap
        }
        .filter{
            text-align: center;
            margin-right:2rem;
            opacity: 0.7;
        }
        .filter:hover{
            opacity:1;
            cursor:pointer;
        }
        .filter p{
            font-size: 0.8rem;
        }
        .tax-info{
            display:none;
        }
        .tax-toggle{
            border:1px solid black;
            border-radius:1rem;
            height:3.5rem;
            padding:1rem;
            margin-left: 5rem;
        }
    </style>

    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire-flame-curved"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-city"></i></div>
            <p>Cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-house-flood-water"></i></div>
            <p>Beaches</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
         <div class="filter">
            <div><i class="fa-solid fa-dungeon"></i></div>
            <p>Villa</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-seedling"></i></div>
            <p>Farms</p>
        </div>
        <div class="tax-toggle">
             <div class="form-switch form-check-reverse">
                <input class="form-check-input" type="checkbox" role="switch" id="switch">
                <label for="switch" class="form-check-label">Total inc. taxes</label>
            </div>
        </div>
    </div>

    <!-- <form action="/listings/new" method="get">. commenting out cause we used navbar button for this 
        <button>Create new</button>
    </form> -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
         <% for(let l of allListings) { %>
            <a href="/listings/<%=l._id%>" class="listing-link">
                <div class="card col listing-card">
                    <!-- <img src="<%= l.image.url %>" class="card-img-top" alt="<%=l.title%>image" style="height:20rem"> -->
                    <img 
                        src="<%= l.image && l.image.url ? l.image.url : 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQT1DflnlW9CQWyZhnX-ev_Fm-sb8SQWAHKIMJqj3cAk1IRKyP-Cj0vvWo&s=10' %>" 
                        class="card-img-top" 
                        alt="<%= l.title %> image" 
                        style="height:20rem">
                      <div class="card-img-overlay"> <!--for overlay effect we use this class for effect after image link-->
                      </div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%=l.title%></b><br>
                            &#8377;<%=l.price?.toLocaleString("en-IN")%>/- night
                            <i class="tax-info"> &nbsp; +18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
         <% } %>
    </div>

    <!-- <ul>
        <% for(let l of allListings) { %>
        <li>    <a href="/listings/<%=l.id%>" >  <%=l.title%> -->  <!--  </a>  </li> whenever clicked on this indvi title it goes to show route 
        <% } %>
    </ul>  -->

    <script>
        let taxSwitch = document.getElementById("switch");
        taxSwitch.addEventListener("click",()=>{
            let taxInfo = document.getElementsByClassName("tax-info");
            for(info of taxInfo){
                if(info.style.display != "inline")
                    info.style.display = "inline";
                else
                    info.style.display = null;
            }
        })
    </script>
</body>
